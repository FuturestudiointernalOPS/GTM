# Copy this file to .env and fill in the values. Never commit .env.

# AI
DEEPSEEK_API_KEY=
AI_PROVIDER=deepseek
AI_MODEL=

# Telegram - one-way notifications to the supervisor
# Bot token from @BotFather; chat id of the group or person to notify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web search
# Exa: API key from https://dashboard.exa.ai (semantic search, find URLs).
EXA_API_KEY=
# Apify: API token from https://console.apify.com/account/integrations
# (runs an Actor and returns its dataset as structured rows).
APIFY_API_KEY=
# SerpApi: key from https://serpapi.com/manage-api-key (classic engine syntax:
# site:, quotes and -terms; free tier has a monthly search quota).
SERPAPI_API_KEY=
