# Copy this file to .env and fill in the values. Never commit .env.

# AI
DEEPSEEK_API_KEY=
AI_PROVIDER=deepseek
AI_MODEL=

# Telegram - one-way notifications to the supervisor
# Bot token from @BotFather; chat id of the group or person to notify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web search
# Exa: API key from https://dashboard.exa.ai (semantic search, find URLs).
EXA_API_KEY=
# Apify: API token from https://console.apify.com/account/integrations
# (runs an Actor and returns its dataset as structured rows).
APIFY_API_KEY=
# SerpApi: key from https://serpapi.com/manage-api-key (classic engine syntax:
# site:, quotes and -terms; free tier has a monthly search quota).
SERPAPI_API_KEY=

# Engagement sample (optional)
# Apify Actor id and JSON input. {platform} and {url} are replaced per creator.
ENGAGEMENT_ACTOR_ID=
ENGAGEMENT_ACTOR_INPUT=
ENGAGEMENT_ACTOR_MAX_ITEMS=

# PostgreSQL (required outside --dry-run)
DATABASE_URL=

# Baserow
BASEROW_URL=
BASEROW_DATABASE_ID=
# Schema JWT for table/field management; a database token for row access.
BASEROW_TOKEN=
BASEROW_AUTH_SCHEME=JWT
BASEROW_ROW_TOKEN=
BASEROW_ROW_AUTH_SCHEME=Token
BASEROW_TABLE_CREATORS=
BASEROW_TABLE_BUYERS=
BASEROW_TABLE_PLATFORMS=
BASEROW_TABLE_CONTACTS=
BASEROW_TABLE_PROOFS=
BASEROW_TABLE_ADS=

# Regulatory checks (official addresses to confirm)
RKN_SEARCH_URL=
RKN_QUERY_FIELD=
RKN_ALLOWED_DOMAINS=
SANCTIONS_LIST_URLS=
BETTING_LICENCE_URLS=
